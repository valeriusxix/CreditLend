# Frontend settings. Copy to .env.local (gitignored) or set them in your hosting provider.
# Only VITE_-prefixed values reach the browser: never put a key or secret in a VITE_ variable.

# The CreditLendPool address printed by contracts/script/Deploy.s.sol (required for the app to work)
VITE_POOL_ADDRESS=
# The block the pool was deployed in (the Liquidate page starts looking for borrowers there)
VITE_POOL_DEPLOY_BLOCK=0

# Where the app reads the chain from. Robinhood's public server is rate-limited, so for launch use a
# dedicated provider as the main server, e.g. Alchemy (restrict the key to your site's domain in its
# dashboard: anything in a VITE_ variable is visible to visitors):
# VITE_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# Backups, tried in order if the main server fails (comma-separated). Robinhood's public server
# (https://rpc.mainnet.chain.robinhood.com) is always added as the last resort automatically.
# VITE_RPC_FALLBACK_URLS=https://another-provider.example/robinhood
# VITE_EXPLORER_URL=https://robin.etherscan.io

# Local testing only (ignored by `npm run build`): point the app at an anvil fork and use its
# unlocked test accounts instead of a browser wallet. Pick one with ?dev_account=N in the URL.
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_DEV_RPC=http://127.0.0.1:8545
