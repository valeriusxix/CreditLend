# Copy to agent/.env and fill in. agent/.env is gitignored: never commit it.

# --- Deployed contracts (printed by contracts/script/Deploy.s.sol) ---
POOL_ADDRESS=
ORACLE_ADDRESS=
RATE_CONTROLLER_ADDRESS=
# Block the pool was deployed in (speeds up finding borrowers at start-up)
POOL_DEPLOY_BLOCK=0

# Optional: a different RPC endpoint (default: https://rpc.mainnet.chain.robinhood.com)
# RPC_URL=

# --- Agent wallet ---
# A DEDICATED hot wallet. Without it the agent only monitors and alerts (read-only).
# Holds ETH for gas (~$10/month at today's prices) and, if auto-liquidation is on, a USDG float.
# Set this address as AGENT when deploying, or later via RateController.setAgent (timelock).
AGENT_PRIVATE_KEY=

# --- Auto-liquidation (off unless set to true; needs a USDG float, ~6,000 recommended) ---
LIQUIDATOR_ENABLED=false
# Minimum profit after buying the CREDIT, in basis points (100 = 1%). Also enforced on-chain via minSeized.
LIQUIDATOR_MIN_PROFIT_BPS=100

# --- Daily AI review through the Orbio gateway (off if ORBIO_API_KEY is empty) ---
ORBIO_API_KEY=
ANTHROPIC_BASE_URL=
AGENT_MODEL=claude-opus-5-5
# Let the agent actually PROPOSE rate switches (otherwise it only reports what it would do)
RATE_PROPOSALS_ENABLED=false

# --- Chat alerts (optional; alerts always go to the log) ---
# A Discord or Slack incoming-webhook URL
ALERT_WEBHOOK_URL=
# Or a Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
